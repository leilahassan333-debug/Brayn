# Optional: Builder.io Space public API key (not a private/write key).
# Copy to .env.local, set the value, then restart npm run dev.
NEXT_PUBLIC_BUILDER_API_KEY=

# Private presentation studio (public Supabase connection settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only OpenAI credential. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_PRESENTATION_MODEL=gpt-4.1-mini

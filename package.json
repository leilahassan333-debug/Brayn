{
  "name": "brayn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run check:boundaries && npm run test:unit && npm run test:server",
    "test:server": "node --conditions=react-server --import tsx --test tests/server/*.test.ts"
  },
  "dependencies": {
    "@builder.io/sdk-react": "^5.4.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jszip": "^3.10.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
